{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": "web",
  "cleanUrls": false,
  "headers": [
    {
      "source": "/(.*)\\.json",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ],
  "redirects": [
    { "source": "/web/:path*", "destination": "/:path*", "permanent": false }
  ]
}
